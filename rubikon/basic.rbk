# basic.rbk — the Basic Modern Solution, as in Mike's notes, in Rubikon.
#
# A draft for review: nothing runs this yet (see LANGUAGE.md).
#
# All names are relative to the cube as it's held.  Whole cube turns
# (x y z) only change the frame: they make no moves of their own, and the
# moves after them come out renamed.  (`show(y)` would make a visible turn;
# this method doesn't need one.)

from cfop import sexy, sune          # well-known sequences (cfop.rbk)

# Lift a piece to the top without disturbing the rest of the bottom, by
# where it is now.  Edge and corner places never match the same piece,
# so one list covers both.  Called with do, like a macro; other files can
# import it (from basic import lift).
algo lift(p: Pattern) "Lift a piece to the top" {
  match {
    case df  is p -> do F2          case fr  is p -> do R<U>
    case dr  is p -> do R2          case br  is p -> do R'<U>
    case db  is p -> do B2          case bl  is p -> do L<U>
    case dl  is p -> do L2          case fl  is p -> do L'<U>
    case dfr is p -> do R<U>        case dbl is p -> do L<U>
    case drb is p -> do R'<U'>      case dlf is p -> do L'<U'>
    otherwise     -> ()                       # already in the top layer
  }
}

algo main "The Basic Modern Solution" goal solved(cube) {

  # The sequences from the notes, written to show how they work, each with
  # the permutation it makes (in cycle notation) under it.
  #
  # A commutator a b a' b' changes little beyond where a and b overlap; a
  # conjugate w<p> is w p w': p done somewhere else (set up with w, then
  # put back).
  # reflect(p, M) is p seen in a mirror through the M slice: left and right
  # swap and every turn goes the other way (see LANGUAGE.md).

  # Take an edge from the top down into the front right slot: two
  # commutators with U, one on each side of the slot.
  let insertRight      = commutator(U, R) commutator(U', F')
                       # (ur lu fu fr ub) (ulb ubr flu)
  let insertLeft       = reflect(insertRight, M)
                       # (ub ul ru fu fl) (ulb fur ubr)

  # Flip up two top edges: sexy (the commutator R U R' U'), set up by F.
  let topCross         = F<sexy>
                       # (ur ub fu) (urf ufl)+ (ubr ulb)-

  # Swap the front and left top edges: Sune cycles three top edges, and
  # the U after it makes that a swap.  (It moves the corners too; later
  # stages fix them.)
  let swapEdges        = sune U
                       # (uf ul) (urf bru bul ufl)

  # Cycle three top corners: a commutator of a right face turn set up by U
  # (U R U') and a left face turn.
  let cycleCorners     = commutator(U<R>, L')
                       # (ufl bru bul)
  let cycleCornersBack = reflect(cycleCorners, M)
                       # (urf bul bru)

  # Twist the front right top corner (a third of a turn) using the
  # commutator of R' and D'; it scrambles the bottom as it goes, but once
  # every top corner is twisted the bottom's twists add up to nothing.
  let twistCorner      = (commutator(R', D'))2
                       # (urf)- (dr fr db) (dfr)- (dbl)+ (drb)+
  let twistCornerBack  = twistCorner'
                       # (urf)+ (dr db fr) (dfr)+ (dbl)- (drb)-

  algo "First Face" goal solved(layer(D)) {

    algo "Bottom Edges" goal solved(df dr db dl) {
      each y {                                      # each bottom edge in turn
        if not solved(df) {
          do lift(/df/r)                            # either way round
          search U* as t {
            case uf is /df/ -> do t F2                    # its bottom color up
            case fu is /df/ -> do t U' R'<F>              # its bottom color in front
          }
        }
      }
    }

    algo "Bottom Corners" goal solved(dfr drb dbl dlf) {
      each y {
        if not solved(dfr) {
          do lift(/dfr/r)
          search U* as t {
            case rfu is /dfr/ -> do t R<U>                # bottom color facing right
            case fur is /dfr/ -> do t F'<U'>              # bottom color facing front
            case urf is /dfr/ -> do t R<U2> U' R<U>       # bottom color up
          }
        }
      }
    }
  }

  algo "Middle" goal solved(fr fl br bl) {
    each y {                                        # each middle slot in turn
      if not solved(fr) {
        # Stuck in a middle slot (flipped in its own, or in another): insert
        # any edge there to lift it out.
        match {
          case fr is /fr/r -> do insertRight
          case br is /fr/r -> do y<insertRight>
          case bl is /fr/r -> do y2<insertRight>
          case fl is /fr/r -> do y'<insertRight>
          otherwise        -> ()                   # already in the top layer
        }
        search U* as t {
          case fu is /fr/ -> do t insertRight          # front color in front
          case ur is /fr/ -> do t y<insertLeft>        # right color on the right
        }
      }
    }
  }

  algo "Top Cross" goal face U [_u_ / uuu / _u_] {
    until goal max 4 {
      search U* as t {
        case face U [_!u_ / uuu   / _!u_] -> do t topCross   # line
        case face U [_u_  / uu!u  / _!u_] -> do t topCross   # L, at the back left
        case face U [_!u_ / !uu!u / _!u_] -> do t topCross   # dot
      }
    }
  }

  algo "Top Edges" goal solved(uf ur ub ul) {
    until goal max 2 {                              # an opposite pair takes two
      search y* U* as t {
        case solved(uf ur ub ul)                          -> do t           # only the top turned
        case uf is /ul/ and ul is /uf/ and solved(ub ur)  -> do t swapEdges   # front and left swapped
        case uf is /ub/ and ub is /uf/ and solved(ul ur)  -> do t swapEdges   # across: swap, try again
      }
    }
  }

  algo "Top Corners" goal placed(urf ufl ulb ubr) {
    until goal max 3 {
      search y* as t {
        case urf is /urf/r and ubr is /ulb/r and ulb is /ufl/r and ufl is /ubr/r
            -> do t cycleCorners                            # front right in place
        case ufl is /ufl/r and ulb is /ubr/r and ubr is /urf/r and urf is /ulb/r
            -> do t cycleCornersBack                        # front left in place
        otherwise -> do cycleCorners                        # none in place: cycle any three
      }
    }
  }

  algo "Twist Corners" goal solved(urf ufl ulb ubr) {
    each U {                                        # turn the top, not the cube
      match {
        case rfu is /u__/ -> do twistCorner         # top color facing right
        case fur is /u__/ -> do twistCornerBack     # top color facing front
        case urf is /u__/ -> ()                     # already right
      }
    }
  }
}
