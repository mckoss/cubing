# cfop.rbk — well-known sequences, by the names cubers use for them.
#
# A module: only definitions, for solutions to import, e.g.
#   from cfop import sune
#   import cfop            # then cfop.sune
# Under each is the permutation it makes, as the engine prints it.
#
# Provenance.  Most of these are in CFOP, the speedcubing method (also
# called the Fridrich method).  Cross and F2L are credited to René Schoof,
# first published by Anneke Treep and Kurt Dockhorn (Netherlands, 1981);
# OLL and PLL to Jessica Fridrich and Mirek Goljan (1981–83).  Fridrich put
# the method on the web in January 1997; the name "CFOP" (the steps' first
# letters) has no known coiner.
#   https://www.speedsolving.com/wiki/index.php/CFOP_method
#   https://en.wikipedia.org/wiki/CFOP_method
# For each sequence below: who is credited with it and who named it, where
# known; "unknown" where no source says.  The standard forms are listed at
#   https://www.speedsolving.com/wiki/index.php/PLL (and OLL)

# Commutators on the top layer.

# Sequence: unknown (older than its name).  Name: Arnaud van Galen, in his
# video series "Complete beginners 3x3x3 tutorial", April 2008.
#   https://www.speedsolving.com/wiki/index.php/Sexy_Move
let sexy         = commutator(R, U)
                 # (ur ub fr) (urf rdf)+ (ubr ulb)-

# Sequence: unknown.  Name: Jeremy Fleischman, 2009 (with its inverse,
# "hedgeslammer").
#   https://www.speedsolving.com/wiki/index.php/Sledgehammer
let sledgehammer = commutator(R', F)
                 # (ur fr fu) (urf frd)- (ufl rub)+

# Orienting the top corners.

# Sequence: older than its name; Wikipedia's article on James Nourse's
# "The Simple Solution to Rubik's Cube" (June 1981) says the book gives it
# for this case.  Name: Lars Petrus, for his method (Sune is a Swedish
# name).
#   https://www.speedsolving.com/wiki/index.php/Sune
#   https://en.wikipedia.org/wiki/The_Simple_Solution_to_Rubik%27s_Cube
let sune         = R<U> U R<U2>
                 # (ur ub ul) (urf lbu)- (ufl ubr)+

# Sune's inverse, hence the name (also called "Chair"); who named it:
# unknown.
#   https://www.speedsolving.com/wiki/index.php/Sune
let antisune     = sune'
                 # (ur ul ub) (urf bul)+ (ubr ufl)-

# Cycling top corners.

# Name: Lars Petrus, for his method's corner step; what it refers to and
# when: unknown.  Sequence: unknown.
#   https://www.speedsolving.com/wiki/index.php/Niklas
let niklas       = commutator(R, U'<L'>)
                 # (urf bru bul)

# The PLLs (permute the last layer).  Their letter names follow the shape
# of the pieces' paths; Fridrich credits the classification to Mirek
# Goljan, early 1980s.  (Subscripts such as Ua/Ub and Ja/Jb may come from
# the Speedsolving wiki and Stefan Lidström; sources differ.)  Who first
# published each move sequence below: unknown.
#   http://www.ws.binghamton.edu/fridrich/Mike/permute.html
#   https://www.speedsolving.com/wiki/index.php/PLL

# A-perm (without whole cube turns: x R' U R' D2 R U' R' D2 R2).
let aPerm        = R'<commutator(F, R'<B2>)>
                 # (urf ulb ubr)

# U-perms.
let uPermA       = R U' R U R U R U' R' U' R2
                 # (uf ur ul)
let uPermB       = uPermA'
                 # (uf ul ur)

# H-perm and Z-perm.
let hPerm        = M2<U> U2 M2<U>
                 # (uf ub) (ur ul)
let zPerm        = M' U M2 U M2 U M' U2 M2 U'
                 # (uf ul) (ur ub)

# T-perm and J-perm (Jb).
let tPerm        = sexy R' F R2 U' R' U' R U R' F'
                 # (ur ul) (urf ubr)
let jPerm        = R U R' F' R U R' U' R' F R2 U' R' U'
                 # (uf ur) (urf ubr)
