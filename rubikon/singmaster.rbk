# singmaster.rbk — David Singmaster's solution (Notes on Rubik's Magic Cube,
# 1981), as the 2003 simulator ran it, in Rubikon.
#
# A sketch for review: nothing runs this yet (see LANGUAGE.md).  It solves
# the top layer first, turns the cube over, and finishes the other layers.
# A search that finds nothing is an error unless `else` names another
# search to try.

solution singmaster for cube3 {

  stage "Solve U Edges" goal solved(uf ur ub ul) {
    each y {
      search D* as t {
        case df is /uf/ -> do t F2
        case fd is /uf/ -> do t F' U' R U
      } else search E* as t {                 # in the middle layer
        case lf is /uf/ -> do t F t'
        case rf is /uf/ -> do t F' t'
      } else search U* as t {                 # in the top layer: park it,
        case uf is /uf/ -> do t F2 t' F2      #   turn the top back, put it in
        case fu is /uf/ -> do t F t' U' R U
      }
    }
  }

  stage "Solve U Corners" goal solved(layer(U)) {
    each y {
      search D* as t {
        case rdf is /urf/ -> do t D F D' F'
        case frd is /urf/ -> do t D' R' D R
        case dfr is /urf/ -> do t F D' F' R' D2 R
      } else search U* as t {
        case urf is /urf/ -> do t F D F' t' F D' F'
        case rfu is /urf/ -> do t R' D2 R t' F D2 F'
        case fur is /urf/ -> do t F D2 F' t' R' D2 R
      }
    }
  }

  show z2                                    # turn the cube over (a visible turn)

  stage "Solve Middle Edges" goal solved(layer(D) layer(E)) {
    each y {
      if not solved(rf) {                    # stuck in the middle: lift it out
        search E* as t {
          case rf is /rf/ -> do t B' U' R2 U2 R2 U2 R2 U2 U B t'
          case fr is /rf/ -> do t L U' F2 U2 F2 U2 F2 U2 U L' t'
        }
      }
      search U* as t {
        case ub is /rf/ -> do t B' U' R2 U2 R2 U2 R2 U2 U B
        case lu is /rf/ -> do t L U' F2 U2 F2 U2 F2 U2 U L'
      }
    }
  }

  stage "Orient D Edges" goal face U [_u_ / uuu / _u_] {   # the new top
    search y* as t {
      case face U [_u_  / uuu   / _u_ ] -> do t
      case face U [_!u_ / uuu   / _!u_] -> do t B L U L' U' B'
      case face U [_!u_ / !uuu  / _u_ ] -> do t B U L U' L' B'         # front and right
      case face U [_!u_ / !uu!u / _!u_] -> do t B L U L' U' B' y2 B U L U' L' B'
    }
  }

  stage "Place D Edges" goal solved(uf ur ub ul) {
    search y* U* as t {                      # cycles of the top edges
      case cube has (uf ur ub)      -> do t R2 D' U2 R' L F2 R L' D R2
      case cube has (uf ub ur)      -> do t R2 D' R' L F2 R L' U2 D R2
      case cube has (uf ur) (ul ub) -> do t R2 D2 B2 D L2 F2 L2 F2 L2 F2 D' B2 D2 R2
      case solved(uf ur ub ul)      -> do t
    }
  }

  stage "Place D Corners" goal placed(urf ufl ulb ubr) {
    search y* as t {                         # positions only, twists ignored
      case positions(cube) has (ufl ulb ubr)       -> do t L' U R U' R' L R U R' U'
      case positions(cube) has (ufl ubr ulb)       -> do t U R U' R' L' R U R' U' L
      case positions(cube) has (ufl urf) (ulb ubr) -> do t B (L U L' U')3 B'
      case positions(cube) has (ufl ubr) (urf ulb) -> do t R' B2 (F R F' R')3 B2 R
    }
  }

  stage "Orient D Corners" goal solved(cube) {
    each U {
      match {
        case rfu is /u__/ -> do (D F D' F')2      # counterclockwise
        case fur is /u__/ -> do (F D F' D')2      # clockwise
        case urf is /u__/ -> ()
      }
    }
  }

  # The 2003 program turns the cube back (z2); "solved however held"
  # makes that optional.
}
