# singmaster.rbk — David Singmaster's solution (Notes on Rubik's Magic Cube,
# 1981), as the 2003 simulator ran it, in Rubikon.
#
# A sketch for review: nothing runs this yet (see LANGUAGE.md).  It solves
# the top layer first, turns the cube over, and finishes the other layers.
# A search that finds nothing is an error unless `else` names another
# search to try.

solution singmaster for cube3 {

  # The sequences, written to show how they work: w<p> is w p w' (p set up
  # with w, then put back), commutator(a, b) is a b a' b'.  Under each is
  # the permutation it makes, in cycle notation.  A case that finds a cycle
  # in the cube (`cube has (uf ur ub)`) does the sequence that makes its
  # inverse (`(uf ub ur)`).

  # Turn the top edges' top colors up: a commutator set up by B.  The edges
  # move as well; a later stage puts them in place.
  let flipLeft          = B<commutator(L, U)>
                        # (uf bu ul) (ufl urf)- (ulb ubr)+
  let flipFront         = B<commutator(U, L)>
                        # (uf ul bu) (urf ufl)+ (ubr ulb)-

  # Swap an edge into the middle layer: (R2 U2)3 swaps two pairs of edges,
  # set up by U' and then B'.
  let swapRight         = B'<U'<(R2 U2)3>>
                        # (ur ul) (ub rf)
  let swapLeft          = L<U'<(F2 U2)3>>
                        # (uf ub) (ul fr)

  # Cycle three top edges, set up by R2 then D'.
  let cycleEdges        = R2<D'<U2 (R' L)<F2>>>
                        # (uf ub ur)
  let cycleEdgesBack    = cycleEdges'
                        # (uf ur ub)
  let swapEdgePairs     = R2<D2<B2<D<(L2 F2)3>>>>
                        # (uf ur) (ub ul)

  # Cycle three top corners, or swap two pairs of them.
  let cycleCorners      = L'<commutator(U, R)> commutator(R, U)
                        # (ufl bul bru)
  let cycleCornersBack  = cycleCorners'
                        # (ufl bru bul)
  let swapCornerPairs   = B<(commutator(L, U))3>
                        # (urf flu) (ulb bru)
  let swapCornersAcross = (R' B2)<(commutator(F, R))3>
                        # (urf bul) (ufl ubr)

  # Twist the front right top corner in place.  The bottom is scrambled
  # too, and the other top corners' twists put it back.
  let twistCorner       = (commutator(F, D))2
                        # (urf)+ (df rf dl) (dfr)+ (dlf)- (dbl)-
  let twistCornerBack   = twistCorner'
                        # (urf)- (df dl rf) (dfr)- (dlf)+ (dbl)+

  stage "Solve U Edges" goal solved(uf ur ub ul) {
    each y {
      search D* as t {
        case df is /uf/ -> do t F2
        case fd is /uf/ -> do t F' U' R U
      } else search E* as t {                 # in the middle layer
        case lf is /uf/ -> do t<F>
        case rf is /uf/ -> do t<F'>
      } else search U* as t {                 # in the top layer: park it,
        case uf is /uf/ -> do t<F2> F2         #   turn the top back, put it in
        case fu is /uf/ -> do t<F> U' R U
      }
    }
  }

  stage "Solve U Corners" goal solved(urf ufl ulb ubr) {
    each y {
      search D* as t {
        case rdf is /urf/ -> do t commutator(D, F)
        case frd is /urf/ -> do t commutator(D', R')
        case dfr is /urf/ -> do t F<D'> R'<D2>
      } else search U* as t {
        case urf is /urf/ -> do t<F<D>> F<D'>
        case rfu is /urf/ -> do t<R'<D2>> F<D2>
        case fur is /urf/ -> do t<F<D2>> R'<D2>
      }
    }
  }

  show z2                                    # turn the cube over (a visible turn)

  stage "Solve Middle Edges" goal solved(fr fl br bl) {
    each y {
      if not solved(rf) {                    # stuck in the middle: lift it out
        search E* as t {
          case rf is /rf/ -> do t<swapRight>
          case fr is /rf/ -> do t<swapLeft>
        }
      }
      search U* as t {
        case ub is /rf/ -> do t swapRight
        case lu is /rf/ -> do t swapLeft
      }
    }
  }

  stage "Orient D Edges" goal face U [_u_ / uuu / _u_] {   # the new top
    search y* as t {
      case face U [_u_  / uuu   / _u_ ] -> do t
      case face U [_!u_ / uuu   / _!u_] -> do t flipLeft
      case face U [_!u_ / !uuu  / _u_ ] -> do t flipFront          # front and right
      case face U [_!u_ / !uu!u / _!u_] -> do t flipLeft y2 flipFront
    }
  }

  stage "Place D Edges" goal solved(uf ur ub ul) {
    search y* U* as t {                      # cycles of the top edges
      case cube has (uf ur ub)      -> do t cycleEdges
      case cube has (uf ub ur)      -> do t cycleEdgesBack
      case cube has (uf ur) (ul ub) -> do t swapEdgePairs
      case solved(uf ur ub ul)      -> do t
    }
  }

  stage "Place D Corners" goal placed(urf ufl ulb ubr) {
    search y* as t {                         # positions only, twists ignored
      case positions(cube) has (ufl ubr ulb)       -> do t cycleCorners
      case positions(cube) has (ufl ulb ubr)       -> do t cycleCornersBack
      case positions(cube) has (ufl urf) (ulb ubr) -> do t swapCornerPairs
      case positions(cube) has (ufl ubr) (urf ulb) -> do t swapCornersAcross
    }
  }

  stage "Orient D Corners" goal solved(cube) {
    each U {
      match {
        case rfu is /u__/ -> do twistCornerBack      # counterclockwise
        case fur is /u__/ -> do twistCorner          # clockwise
        case urf is /u__/ -> ()
      }
    }
  }

  # The 2003 program turns the cube back (z2); "solved however held"
  # makes that optional.
}
